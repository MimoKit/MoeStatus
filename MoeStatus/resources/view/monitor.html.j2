<!doctype html>
<html lang="zh-CN">

<head>
  <meta charset="utf-8">
  <title>{{ mascot_name }}体检所 · 趋势</title>
  <style>{% include "style.css" %}</style>
</head>

<body>
  <main id="container" class="page vd-good">

    <header class="top">
      <div class="top__mark">{% with mood = "good" %}{% include "_mascot.html.j2" %}{% endwith %}</div>
      <div class="top__text">
        <div class="top__name">{{ mascot_name }}体检所 · 趋势</div>
        <div class="top__time num">{{ generated_at }}</div>
      </div>
    </header>

    <div class="grid">
      <section class="card card--wide">
        <h2 class="card__title">采样记录</h2>
        {% if charts %}
        <div class="charts">
          {% for c in charts %}
          <div class="chart">
            <div class="chart__head">
              <span class="chart__name">{{ c.name }}</span>
              <span class="chart__val num">{{ c.latest }}</span>
            </div>
            <svg class="chart__svg" viewBox="0 0 100 40" preserveAspectRatio="none" role="img"
              aria-label="{{ c.name }} 历史曲线">
              <defs>
                <linearGradient id="mb{{ loop.index }}" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="{{ c.color }}" stop-opacity=".28" />
                  <stop offset="100%" stop-color="{{ c.color }}" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d="{{ c.area_path }}" fill="url(#mb{{ loop.index }})" />
              <path d="{{ c.line_path }}" fill="none" stroke="{{ c.color }}" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="chart__foot num"><span>{{ c.ticks[0] if c.ticks else "" }}</span><span>峰值 {{ c.peak }}</span><span>{{ c.ticks[-1] if c.ticks else "" }}</span></div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="empty">还没采到数据。等后台跑满一个采样周期，或到配置里把「开启采样任务」打开。</p>
        {% endif %}
      </section>
    </div>

    <footer class="foot">
      <span>MoeStatus <b>v{{ version }}</b> · {{ mascot_name }}体检所</span>
      <span class="num">{{ footer_right }}</span>
    </footer>

  </main>
</body>

</html>