{#- 早柚吉祥物：一只会随体检结论变表情的柚子。level 决定眼神与嘴形。 -#}
<svg class="mascot" viewBox="0 0 160 168" role="img" aria-label="早柚吉祥物，表情表示当前体检结论">
  <ellipse cx="80" cy="158" rx="46" ry="7" fill="#3A3453" opacity=".10"/>

  {#- 叶子与果蒂 -#}
  <path d="M80 34 C 74 18, 58 12, 46 16 C 50 32, 64 40, 80 34 Z" fill="#8FCB87" stroke="#3A3453" stroke-width="4"
        stroke-linejoin="round"/>
  <path d="M78 33 C 68 29, 58 24, 50 18" fill="none" stroke="#3A3453" stroke-width="2.4" stroke-linecap="round"
        opacity=".55"/>
  <path d="M80 34 L 80 44" stroke="#3A3453" stroke-width="5" stroke-linecap="round"/>

  {#- 果身 -#}
  <circle cx="80" cy="100" r="54" fill="#F5E7A6" stroke="#3A3453" stroke-width="4.5"/>
  <path d="M40 74 C 52 62, 74 58, 96 62" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round"
        opacity=".5"/>

  {#- 腮红 -#}
  <ellipse cx="46" cy="112" rx="11" ry="7.5" fill="#F9A8C4" opacity=".8"/>
  <ellipse cx="114" cy="112" rx="11" ry="7.5" fill="#F9A8C4" opacity=".8"/>

  {#- 眼睛 -#}
  {% if mood == "good" %}
  <path d="M56 96 q 10 -12 20 0" fill="none" stroke="#3A3453" stroke-width="4.6" stroke-linecap="round"/>
  <path d="M84 96 q 10 -12 20 0" fill="none" stroke="#3A3453" stroke-width="4.6" stroke-linecap="round"/>
  {% elif mood == "warn" %}
  <circle cx="66" cy="95" r="7" fill="#3A3453"/>
  <circle cx="94" cy="95" r="7" fill="#3A3453"/>
  <circle cx="68.5" cy="92" r="2.4" fill="#FFFFFF"/>
  <circle cx="96.5" cy="92" r="2.4" fill="#FFFFFF"/>
  {% else %}
  <path d="M58 88 l 16 14 M74 88 l -16 14" stroke="#3A3453" stroke-width="4.6" stroke-linecap="round"/>
  <path d="M86 88 l 16 14 M102 88 l -16 14" stroke="#3A3453" stroke-width="4.6" stroke-linecap="round"/>
  {% endif %}

  {#- 嘴 -#}
  {% if mood == "good" %}
  <path d="M70 118 q 10 9 20 0" fill="none" stroke="#3A3453" stroke-width="4" stroke-linecap="round"/>
  {% elif mood == "warn" %}
  <path d="M70 120 h 20" fill="none" stroke="#3A3453" stroke-width="4" stroke-linecap="round"/>
  {% else %}
  <path d="M66 120 q 7 -7 13 0 q 6 7 13 0" fill="none" stroke="#3A3453" stroke-width="4" stroke-linecap="round"/>
  <path d="M112 62 c 7 8, 7 14, 0 17 c -7 -3, -7 -9, 0 -17 Z" fill="#8FC8F0" stroke="#3A3453" stroke-width="3.2"
        stroke-linejoin="round"/>
  {% endif %}
</svg>
